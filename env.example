# Google Gemini API (obligatoria: modelo por defecto, TTS y consulta de manuales)
GOOGLE_GENAI_API_KEY=tu_api_key_aqui

# Modelo de IA (opcional). Valores: googleai/<modelo>, groq/<modelo> o local/<modelo>
# Si se omite: groq/qwen/qwen3.8-27b cuando hay GROQ_API_KEY; si no, googleai/gemini-3.5-flash
# GEMINI_MODEL=googleai/gemini-3.5-flash

# Groq (opcional). Activa el proveedor Groq con rotación de modelos ante límites de cuota
# GROQ_API_KEY=tu_api_key_groq

# IA local con Ollama (opcional, gratuita e ilimitada; https://ollama.com).
# Respaldo cuando Groq agota su cuota. Con GEMINI_MODEL=local/<modelo> se usa como principal.
# LOCAL_LLM_MODEL=qwen3.8:27b
# LOCAL_LLM_BASE_URL=http://localhost:11434/v1

TTS_PROVIDER=gemini
GEMINI_TTS_VOICE=Enceladus
GEMINI_TTS_STYLE=Empathetic
GEMINI_TTS_PACE=Normal
GEMINI_TTS_ACCENT=España castellano

# Eleven Labs TTS
ELEVENLABS_API_KEY=tu_api_key_eleven_labs
ELEVENLABS_VOICE_ID=tu_voice_id_preferido
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Base URL (Opcional, default: http://localhost:3000)
# NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Otras configuraciones
NODE_ENV=development
